{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "access-log",
      "folder": "Access Log Lab",
      "interval": "10s",
      "rules": [
        {
          "uid": "access-errors",
          "title": "Access errors",
          "condition": "B",
          "for": "20s",
          "noDataState": "KeepLast",
          "execErrState": "Error",
          "labels": {
            "lab": "access-log"
          },
          "annotations": {
            "summary": "5xx >= 20% with >= 10 completed requests in 1m. Check Explore and request_id."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((100 * (sum(count_over_time({job=\"access-log-lab\"} | json | __error__=\"\" | status >= 500 [1m])) or vector(0)) / sum(count_over_time({job=\"access-log-lab\"} | json | __error__=\"\" [1m]))) >= bool 20) and (sum(count_over_time({job=\"access-log-lab\"} | json | __error__=\"\" [1m])) >= 10)",
                "queryType": "instant",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                }
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "classic_conditions",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "access-slow",
          "title": "Access slow",
          "condition": "B",
          "for": "20s",
          "noDataState": "KeepLast",
          "execErrState": "Error",
          "labels": {
            "lab": "access-log"
          },
          "annotations": {
            "summary": "At least 3 requests >= 1000ms with >= 10 completed requests in 1m."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "((sum(count_over_time({job=\"access-log-lab\"} | json | __error__=\"\" | request_time_ms >= 1000 [1m])) or vector(0)) >= bool 3) and (sum(count_over_time({job=\"access-log-lab\"} | json | __error__=\"\" [1m])) >= 10)",
                "queryType": "instant",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                }
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "classic_conditions",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "access-missing",
          "title": "Access logs missing",
          "condition": "B",
          "for": "20s",
          "noDataState": "KeepLast",
          "execErrState": "Error",
          "labels": {
            "lab": "access-log"
          },
          "annotations": {
            "summary": "No valid access logs in 1m. Check traffic, demo, Alloy, Loki and clock."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum(count_over_time({job=\"access-log-lab\"} | json | __error__=\"\" [1m])) or vector(0)",
                "queryType": "instant",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                }
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "classic_conditions",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "contactPoints": [
    {
      "orgId": 1,
      "name": "local-webhook",
      "receivers": [
        {
          "uid": "local-webhook",
          "type": "webhook",
          "disableResolveMessage": false,
          "settings": {
            "url": "http://notification-sink:8081",
            "httpMethod": "POST"
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "local-webhook",
      "group_by": [
        "alertname"
      ],
      "group_wait": "5s",
      "group_interval": "10s",
      "repeat_interval": "1h"
    }
  ]
}
