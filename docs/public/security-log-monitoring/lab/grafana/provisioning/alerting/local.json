{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "security-log",
      "folder": "Security Log Lab",
      "interval": "10s",
      "rules": [
        {
          "uid": "security-login",
          "title": "Repeated login failures",
          "condition": "B",
          "for": "20s",
          "noDataState": "KeepLast",
          "execErrState": "Error",
          "labels": {
            "lab": "security-log"
          },
          "annotations": {
            "summary": ">=10 failed demo logins per client_ip and account in 1m; investigate before blocking."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum by (client_ip, account) (count_over_time({job=\"security-log-lab\"} | json | __error__=\"\" | event=\"auth\" | outcome=\"failure\" [1m]))) or (0 * sum by (client_ip, account) (count_over_time({job=\"security-log-lab\"} | json | __error__=\"\" | event=\"auth\" [1m])))",
                "queryType": "instant",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                }
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        9
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ],
                "expression": "A"
              }
            }
          ]
        },
        {
          "uid": "security-paths",
          "title": "Repeated missing paths",
          "condition": "B",
          "for": "20s",
          "noDataState": "KeepLast",
          "execErrState": "Error",
          "labels": {
            "lab": "security-log"
          },
          "annotations": {
            "summary": ">=20 HTTP 404 per client_ip in 1m; inspect path diversity and releases."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum by (client_ip) (count_over_time({job=\"security-log-lab\"} | json | __error__=\"\" | status = 404 | __error__=\"\" [1m]))) or (0 * sum by (client_ip) (count_over_time({job=\"security-log-lab\"} | json | __error__=\"\" [1m])))",
                "queryType": "instant",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                }
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        19
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ],
                "expression": "A"
              }
            }
          ]
        },
        {
          "uid": "security-missing",
          "title": "Security logs missing",
          "condition": "B",
          "for": "20s",
          "noDataState": "KeepLast",
          "execErrState": "Error",
          "labels": {
            "lab": "security-log"
          },
          "annotations": {
            "summary": "No valid security lab logs in 1m; check collector and traffic."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum(count_over_time({job=\"security-log-lab\"} | json | __error__=\"\" [1m])) or vector(0)",
                "queryType": "instant",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                }
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ],
                "expression": "A"
              }
            }
          ]
        }
      ]
    }
  ],
  "contactPoints": [
    {
      "orgId": 1,
      "name": "local-webhook",
      "receivers": [
        {
          "uid": "local-webhook",
          "type": "webhook",
          "disableResolveMessage": false,
          "settings": {
            "url": "http://notification-sink:8081",
            "httpMethod": "POST"
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "local-webhook",
      "group_by": [
        "alertname"
      ],
      "group_wait": "5s",
      "group_interval": "10s",
      "repeat_interval": "1h"
    }
  ]
}
